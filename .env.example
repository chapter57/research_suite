# Copy to .env.local and fill in. Never commit the real key.
# Get a key at https://console.anthropic.com (Settings -> API keys) and add a payment method.
ANTHROPIC_API_KEY=

# Which Claude model the coach uses. Default: claude-haiku-5-5 (fast and inexpensive, ~$0.10/$0.50 per 1M tokens).
# Stronger options: claude-sonnet-5-5 ($2/$10) or claude-opus-5-5 ($4/$20).
COACH_MODEL=claude-haiku-5-5

# Max coach requests per student browser per day (simple cost guard).
COACH_DAILY_LIMIT=60
